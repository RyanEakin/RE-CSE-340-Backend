<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/edit_categories/<%=catDetails.category_id%>" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input
        type="text"
        id="categoryName"
        name="categoryName"
        value="<%=catDetails.category_name%>"
        maxlength="150"
        required
      />
    </div>

    <button type="submit">Edit Category</button>
    </form>
</main>
<%- include('partials/footer') %>