<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/edit_project/<%= projDetails[0].project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= projDetails[0].title%>"
        maxlength="150"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        maxlength="500"
        required
      ><%= projDetails[0].description%></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= projDetails[0].location %>"
        maxlength="255"
        required
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= projDetails[0].project_date %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select
        id="organizationId"
        name="organizationId"
        required
      >
        <option value="<%= orgDetails.organization_id %>" selected>Select an organization</option>
        <% orgDetails.forEach(org => { %>
          <option value="<%=  org.organization_id %>"><%=  org.name %></option>
        <% }); %>
      </select>
    </div>

    <button type="submit">Edit Project</button>
    </form> 
</main>
<%- include('partials/footer') %>