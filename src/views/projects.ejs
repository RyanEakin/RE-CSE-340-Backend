
<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>
<ul>
<% projects.forEach(project => { %>
    <li><a href="/project/<%= project.project_id %>"><strong><%= project.project_date %></strong>: <%= project.title %></a><a href="/organization/<%= project.organization_id%>"> (<%= project.name %>)</a></li>
<% }); %>
</ul>
<% if (user && user.role_name === 'admin') { %>
<p><a href="/new_project">Add a New Service Project</a></p>
<% } %>
    </main>
<%- include('partials/footer') %>
