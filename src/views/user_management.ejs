<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

<table>
    <tr>
        <td>Name</td>
        <td>Email</td>
        <td>Role</td>
    </tr>
    <% userDetails.forEach(user => { %>
        <tr>
            <td><%= user.name%></td>
            <td><%= user.email%></td>
            <td><%= user.role_name%></td>
        </tr>
    <% }); %>
</table>
</main>
<%- include('partials/footer') %>