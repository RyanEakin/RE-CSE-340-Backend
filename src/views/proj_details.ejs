<%- include('partials/header') %>
<main>
    
<ul>
<% projDetails.forEach(project => { %>
    <p><strong><%= project.title %></strong>: <%= project.description %> <br> <strong>Date:</strong> <%= project.project_date %> ; <strong>Location:</strong> <%= project.location %></p>
    <a href="/organization/<%= project.organization_id %>">Back to <%= project.name %></a>
    <% if (isLoggedIn) { %>
        <br>
    <a href="/volunteer/<%= project.project_id %>">Volunteer for <%= project.title %></a>
    <% } %>
<% }); %>



<br>Tags:
<% catDetails.forEach(category => { %>
    <li><a href="/category/<%= category.category_id %>"> <%= category.category_name %></a></li>
<% }); %>
<br>_________________________ <br>
<% if (user && user.role_name === 'admin') { %>
    <a href="/assign_categories/<%= projDetails[0].project_id %>">Edit Categories</a>

    <a href="/edit_project/<%= projDetails[0].project_id%>">Edit Project</a>
<% } %>
</ul>

    </main>
<%- include('partials/footer') %>
